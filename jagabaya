# 1. OrangSiber SCANNER (HIGH ACCURACY - minim false positive)
#══════════════════════════════════════════════════════════════════════════
OrangSiber_scanner() {
    local target="$1"; local custom="$2"
    [ -z "$target" ] && { fail "Usage: scan <IP/domain> [custom_folder]"; return 1; }
    local dir=$(gen_folder "$target" "$custom")
    mkdir -p "$dir"
    info "Starting OrangSiber Scanner on $target"
    # 1. Masscan
    info "Masscan (quick) ..."
    masscan -p1-65535 --rate=10000 "$target" -oG "$dir/masscan.txt" 2>/dev/null
    local open_count=$(grep -c "open" "$dir/masscan.txt")
    [ "$open_count" -gt 0 ] && ok "Masscan: $open_count port terbuka" || warn "Masscan: 0 port terbuka."

    # 2. Nmap
    info "Nmap (version + vuln scripts) ..."
    local ports=$(grep "open" "$dir/masscan.txt" 2>/dev/null | cut -d'/' -f1 | tr '\n' ',' | sed 's/,$//')
    if [ -n "$ports" ]; then
        nmap -sV -sC --script=vuln -p"$ports" "$target" -oN "$dir/nmap.txt" 2>/dev/null
    else
        nmap -sV -sC --script=vuln "$target" -oN "$dir/nmap.txt" 2>/dev/null
    fi
    local services=$(grep -Ec "^[0-9]+/tcp" "$dir/nmap.txt")
    ok "Nmap: $services service"
    # 3. Nuclei (verified)
    if command -v nuclei &>/dev/null; then
        info "Nuclei (verified) ..."
        nuclei -u "$target" -severity critical,high,medium -o "$dir/nuclei.txt" -silent -stats -verify 2>/dev/null
        ok "Nuclei selesai."
    else
        fail "Nuclei tidak tersedia."
    fi
    # 4. FFuF
    local wordlist="/usr/share/wordlists/seclists/Discovery/Web-Content/common.txt"
    [ ! -f "$wordlist" ] && wordlist="/usr/share/wordlists/dirb/big.txt"
    info "Directory brute (FFuF) ..."
    ffuf -u "http://$target/FUZZ" -w "$wordlist" -e .php,.html,.txt,.bak -fc 403,404 -o "$dir/ffuf.json" -s -t 100 2>/dev/null
    # 5. Nikto
    info "Nikto ..."
    nikto -h "$target" -o "$dir/nikto.txt" -Format txt -Tuning 123456789 2>/dev/null
    print_summary "$dir"
}

