# Cek dependencies (auto-install dengan apt & pip)
cek_dep() {
    info "Memeriksa dan menginstall dependencies..."
    local tools=("nmap" "masscan" "sqlmap" "ffuf" "nikto" "searchsploit" "nuclei" "theHarvester" "sherlock" "recon-ng" "setoolkit" "slowloris" "hping3" "cewl" "crunch" "msfvenom" "msfconsole" "curl" "wget" "xsstrike" "exiftool" "jq" "unzip" "git" "python3" "python3-pip")
    local missing=()
    for tool in "${tools[@]}"; do
        command -v "$tool" &>/dev/null || missing+=("$tool")
    done
    if [ ${#missing[@]} -ne 0 ]; then
        warn "Tools tidak ditemukan: ${missing[*]}"
        echo -ne "${Y}Install otomatis? (Y/n): ${N}"
        read -r ans
        if [[ "$ans" =~ ^[Yy]$ ]] || [ -z "$ans" ]; then
            apt-get update -qq && apt-get install -y -qq "${missing[@]}" 2>/dev/null
            # Khusus nuclei (install via binary)
            if ! command -v nuclei &>/dev/null; then
                wget -q https://github.com/projectdiscovery/nuclei/releases/latest/download/nuclei-linux-amd64.zip -O /tmp/nuclei.zip
                unzip -o /tmp/nuclei.zip -d /usr/local/bin/ && chmod +x /usr/local/bin/nuclei
                nuclei -update-templates &>/dev/null &
            fi
            # Install xsstrike via pip jika belum
            pip3 install xsstrike &>/dev/null
            ok "Dependencies terinstall."
        else
            fail "Beberapa tools wajib ada. Install manual atau jalankan script lagi."
            return 1
        fi
    fi
    # Pastikan wordlist
    [ -f /usr/share/wordlists/dirb/big.txt ] || apt-get install -y dirb
    [ -d /usr/share/wordlists/seclists ] || {
        warn "Download SecLists..."
        git clone --depth 1 https://github.com/danielmiessler/SecLists.git /usr/share/wordlists/seclists &>/dev/null
    }
    return 0
}

# Generator folder hasil
gen_folder() {
    local target="$1"
    local custom="$2"
    if [ -n "$custom" ]; then
        echo "hasil/${custom}"
    else
        echo "hasil/${target}_$(date +%Y%m%d_%H%M%S)"
    fi
}

# Ringkasan scan (cross-check)
print_summary() {
    local dir="$1"
    echo -e "\n${W}══ RINGKASAN SCAN ══${N}"
    [ -f "$dir/nmap.txt" ] && {
        local ports=$(grep -Ec "^[0-9]+/tcp" "$dir/nmap.txt")
        local vuln_nmap=$(grep -i "VULNERABLE" "$dir/nmap.txt" | wc -l)
        ok "Port terbuka: $ports | Nmap Vuln: $vuln_nmap"
    }
    [ -f "$dir/nuclei.txt" ] && {
        local nuc=$(wc -l < "$dir/nuclei.txt")
        ok "Nuclei verified: $nuc temuan"
    }
    [ -f "$dir/ffuf.json" ] && {
        local dirs=$(jq '.results | length' "$dir/ffuf.json" 2>/dev/null || echo 0)
        ok "Direktori: $dirs"
    }
    echo -e "${G}[✓] Data lengkap disimpan di: $dir${N}"
}

